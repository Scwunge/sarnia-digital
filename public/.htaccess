# Sarnia Digital: a static site on OVH web hosting (Apache).
Options -Indexes
RewriteEngine On

# One address, https://sarnia.digital. OVH ends TLS in front of Apache, so plain HTTP arrives on port 80.
RewriteCond %{SERVER_PORT} 80 [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://sarnia.digital/$1 [R=301,L]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  # The page itself is checked every visit, so a new build shows at once.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
